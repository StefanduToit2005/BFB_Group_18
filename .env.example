# Copy this file to .env and fill in your own values. Never commit .env.
FLASK_ENV_NAME=development
SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=medilink

# Second, empty database used only by pytest
TEST_DB_NAME=medilink_test